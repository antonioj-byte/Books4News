# Copia este archivo a .env y rellena los valores. .env no se sube a git.
ANTHROPIC_API_KEY=
# Alternativa si el entorno no deja pasar ANTHROPIC_API_KEY (se usa solo si la anterior está vacía)
FOLIO_ANTHROPIC_API_KEY=
GOOGLE_BOOKS_API_KEY=
# Retratos de autor generados con IA (arte.retrato_generado en config/pipeline.yaml)
MAGNIFIC_API_KEY=
# Email de contacto para el User-Agent de Open Library (lo piden en sus normas de uso)
OPENLIBRARY_CONTACT=
