# Copia este archivo a .env y rellena los valores. .env no se sube a git.
ANTHROPIC_API_KEY=
# Alternativa si el entorno no deja pasar ANTHROPIC_API_KEY (se usa solo si la anterior está vacía)
FOLIO_ANTHROPIC_API_KEY=
GOOGLE_BOOKS_API_KEY=
# Retratos de autor generados con IA (arte.retrato_generado en config/pipeline.yaml)
MAGNIFIC_API_KEY=
# Publicación en Instagram (folio instagram …; docs/instagram.md)
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
# URL pública de la web (p. ej. https://folio-web.up.railway.app) y clave larga y aleatoria para firmar
# los enlaces que Instagram usa para descargar las imágenes
FOLIO_URL_PUBLICA=
FOLIO_CLAVE_ENLACES=
# Ejecución diaria automática en la API (hora local de FOLIO_ZONA, por defecto Europe/Madrid)
FOLIO_EJECUCION_DIARIA=          # p. ej. 04:45: la mesa del día lista a las 5:30
# Email de contacto para el User-Agent de Open Library (lo piden en sus normas de uso)
OPENLIBRARY_CONTACT=
